# ===== Telegram =====
# Token from @BotFather. Never commit the real value.
BOT_TOKEN=
OWNER_ID=6343943842
OWNER_USERNAME=@belyak345
# Optional read-only admins: comma-separated numeric IDs. They cannot use the console.
ADMIN_IDS=
# Comma-separated numeric IDs that are silently ignored.
BLACKLIST_IDS=
# Private group for team copies of reports/applications/donations. 0 disables.
TEAM_CHAT_ID=0

# webhook (default) or polling (useful behind NAT / local smoke tests).
BOT_MODE=webhook
BOT_USERNAME=Aetherlynbot
# In groups: false = answer when Eva is called by name, mentioned, or replied to.
# true = answer every group message (noisy and uses more LLM quota).
GROUP_REPLY_ALL=false
# true = Eva ignores free-form text and works only via buttons/commands.
# This is the default and recommended mode.
MENU_ONLY=true
WEBHOOK_BASE_URL=https://eva.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
DROP_PENDING_UPDATES=false

# Optional subscription gate. REQUIRED_CHANNEL_ID must be a numeric chat id
# (e.g. -1001234567890), not an invite link. Leave 0 to disable.
REQUIRED_CHANNEL_ID=0
REQUIRED_CHANNEL_URL=

# ===== LLM (OpenAI-compatible) =====
# Leave LLM_API_KEY empty to use deterministic extraction from the knowledge base.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=450
# false = strict Aetherlyn-only mode; true = free-form answers for off-topic questions.
ALLOW_GENERAL_TOPICS=false

# ===== Storage / paths =====
DATABASE_URL=
DATABASE_PATH=data/eva.sqlite3
DATA_DIR=data
KB_DIR=data/kb
BACKUP_DIR=backups
LOG_LEVEL=INFO
LOG_JSON=false
AUTO_INGEST_DOCS=true

# ===== Anti-abuse =====
THROTTLE_PER_MINUTE=5
THROTTLE_PER_HOUR=40
THROTTLE_MUTE_SECONDS=600
MAX_INPUT_CHARS=2000
MAX_UPLOAD_BYTES=20971520
MAX_ANSWER_CHARS=900

# ===== Knowledge base =====
SEARCH_TOP_K=6
MIN_SEARCH_CONFIDENCE=0.55
POST_CHUNK_SIZE=700
POST_CHUNK_OVERLAP=80
INCREMENTAL_INGEST_MINUTES=10
FULL_REINDEX_HOUR_MSK=4

# ===== Pterodactyl (read-only by default) =====
PANEL_BASE=https://mgr.hosting-minecraft.pro/api/client
PANEL_KEY=
SERVER_ID=acd21ae2-4cf0-49e2-89cc-d8f90866505a
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# Public Minecraft host/IP. Deliberately empty until the owner supplies it.
SERVER_HOST=
SERVER_PORT=25646
STATUS_CACHE_SECONDS=30
STATUS_POLL_MINUTES=15
PROMO_COMMAND_TEMPLATE=promo create {code} {seals}
CONSOLE_OUTPUT_LIMIT=1500
CONFIRMATION_TTL_SECONDS=30
# Persist SQLite through the game server's Pterodactyl file API.
REMOTE_BACKUP_ENABLED=true

# ===== Telethon reader (read-only; needs a user session) =====
TG_API_ID=0
TG_API_HASH=
TG_SESSION=
TG_CHANNELS_FILE=data/kb/channels.yaml

# ===== Schedule / backup =====
TIMEZONE=Europe/Moscow
DIGEST_HOUR=12
DIGEST_MINUTE=0
BACKUP_RETENTION_DAYS=14
UNANSWERED_ALERT_THRESHOLD=10
HEALTHCHECK_MINUTES=15

# ===== Output guards =====
ALLOWED_LINK_DOMAINS=t.me,telegram.me,telegram.org

# ===== Payment requisites =====
# Deliberately omitted from the public example. Set PAYMENT_CARD_UZS / PAYMENT_CARD_USD /
# PAYMENT_CARD_RUB in the real .env on the host. Without them the owner-supplied
# requisites compiled into Settings are used; never put card numbers in the knowledge base.
