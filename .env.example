# Пример файла секретов. Скопируй в .env и впиши свои значения.
# Переменные окружения важнее этих строк.

RM_AI_BOT_TOKEN=токен_от_BotFather
RM_AI_DEEPSEEK_KEY=ключ_от_DeepSeek

# RM_AI_URL=https://api.deepseek.com/v1/chat/completions
# RM_AI_MODEL=deepseek-chat

# Информация показывается в карточке сервера; кнопки «Сайт» в меню больше нет.
RM_SITE_URL=https://t.me/c/4322573414/609

# Кому уходят заявки и отчёты: владелец и доверенный помощник
SUPER_ADMIN=числовой_id_владельца
HELP_ADMINS=числовой_id_владельца,числовой_id_помощника
BROADCAST_ADMINS=числовой_id_владельца,числовой_id_помощника

# Проверка статуса сервера (Java — через запятую, Bedrock — один адрес)
MC_SERVERS=aetherlyn34.mcmod.ru:25565,aetherlyn.mcmod.ru:25565
MC_BEDROCK=107.161.154.218:25599

# Расход ИИ
AI_MAX_TOKENS=800
HISTORY_TURNS=4
AI_CACHE_TTL=3600
DM_AI_PER_MIN=10
DM_AI_PER_DAY=400

# Плавная печать ответов
TYPE_ANIMATION=on
TYPE_CPS=90
TYPE_INTERVAL=0.5
TYPE_GROUP_CPS=150
TYPE_GROUP_INTERVAL=2.8
TYPE_MAX_SEC=10
TYPE_MIN_CHARS=36
POLL_STUCK_SEC=300

# Консоль сервера через RCON (для облака; локально можно задать /rcon set)
RCON_HOST=адрес_сервера
RCON_PORT=25575
RCON_PASS=пароль_rcon
RCON_ON=on
